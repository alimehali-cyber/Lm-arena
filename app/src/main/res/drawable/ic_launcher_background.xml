<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background: the ZIG logo's own backdrop colour.

    It is a flat fill on purpose. The foreground layer is a full-bleed render of the logo on the
    same #F7F6F7, so the two layers meet with no visible seam and the launcher's mask can cut the
    icon to any shape without exposing an edge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#F7F6F7"
        android:pathData="M0,0h108v108h-108z" />
</vector>
