<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ always shows a system splash. Make it a plain field of the velvet's darkest tone
         (no icon) so it hands off invisibly to the animated splash, whose first frame is the same
         colour and which then "lights up" the velvet. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/zig_splash_velvet_dark</item>
        <item name="android:windowSplashScreenBackground">@color/zig_splash_velvet_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
