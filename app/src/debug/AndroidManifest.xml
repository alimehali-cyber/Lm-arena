<?xml version="1.0" encoding="utf-8"?>
<!-- G-1.8/L12: debug-only FileProvider backing the field-trial Share action
     (zip is written to cacheDir/fieldtrial-*.zip). Absent from release builds:
     this manifest exists only in app/src/debug. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fieldtrial_files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fieldtrial_paths" />
        </provider>
    </application>
</manifest>
