/**
 * M1 regolithSurface — rocky bodies: Moon, Mercury, Mars, Venus radar mode
 * Per §8.1 and §9.1
 *
 * Inputs: albedo (sRGB), normal (tangent space OpenGL +Y up), height (R16F or R8),
 * AO (R8), horizon (N x R8), roughness scalar, albedoScale, proceduralStrength, proceduralScale
 *
 * Requirements:
 * - Displacement: vertex block samples height map with level-aware LOD bias, displaces along vertex normal by (height - referenceRadius) * displacementScale
 * - Must accept optional UV offset/scale for hero patch geometry that covers sub-region
 * - Normals: recompute tangent frame perturbation from height derivative at displaced resolution, or use shipped normal map (choose by tier)
 * - Shadow: horizon-map lookup as described in §6.6; multiply direct sun by 0 or 1 with smooth step ~1 deg to avoid aliasing
 * - AO multiplies ambient/indirect only, never direct sun
 * - Procedural micro-detail optional off by default for science modes, on for inspection mode, always reported through data HUD
 * - Micro-detail must use noise field that does not tile visibly at any zoom (domain-warped, scale-locked to object radii, never screen space)
 *
 * Verified fact: custom vertex blocks CAN modify geometry (worldPosition), and material flag that skips custom vertex work on depth-only passes must NOT be enabled for materials whose vertex block moves geometry, or shadows will be wrong. Recorded in DECISIONS.md.
 */

material {
    name : regolithSurface,
    shadingModel : lit,
    blending : opaque,
    parameters : [
        { type : sampler2d, name : albedoMap },
        { type : sampler2d, name : normalMap },
        { type : sampler2d, name : heightMap },
        { type : sampler2d, name : aoMap },
        { type : sampler2d, name : horizonMap }, // 16 azimuths packed as RGBA8 x4 or R8 x16, see §6.6
        { type : float, name : roughness },
        { type : float, name : albedoScale },
        { type : float, name : proceduralStrength },
        { type : float, name : proceduralScale },
        { type : float, name : displacementScale },
        { type : float, name : referenceRadius },
        { type : float, name : normalStrength },
        { type : float2, name : uvOffset },
        { type : float2, name : uvScale },
        { type : float, name : horizonEnabled },
        { type : float3, name : sunDirection }
    ],
    requires : [ uv0, position, tangents ],
    shadingModel : lit,
    vertexDomain : object,
    variables : [ lightDir ],
    // Do NOT enable skipCustomVertexWorkOnDepth - we move geometry in vertex block per verified fact
    culling : back
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // Displacement in vertex block per §9.1 primary approach: runtime GPU displacement sampling height map with LOD bias
        // heightMap stores (height - referenceRadius) in metres scaled to object radii, or normalized 0..1
        vec2 uv = getUV0() * materialParams.uvScale + materialParams.uvOffset;
        float height = texture(materialParams_heightMap, uv).r;
        // height is in [0,1] where 0.5 = referenceRadius, or directly in metres depending on pack manifest
        // For M1, we use (height - 0.5) * displacementScale as displacement along vertex normal
        // referenceRadius comes from manifest so displacement is in real metres scaled to object radii
        float displacement = (height - 0.5) * materialParams.displacementScale;
        // Displace along vertex normal (object space)
        // Note: worldPosition modification is allowed in custom vertex block, verified fact
        material.worldPosition.xyz += material.worldNormal * displacement;
    }
}

fragment {
    // Domain-warped noise for procedural micro-detail, scale-locked to object radii, never screen space
    // 3-octave fBm with domain warp, scale = proceduralScale (object radii)
    float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453); }
    float noise(vec2 p) {
        vec2 i = floor(p);
        vec2 f = fract(p);
        f = f*f*(3.0-2.0*f);
        float a = hash(i);
        float b = hash(i+vec2(1.0,0.0));
        float c = hash(i+vec2(0.0,1.0));
        float d = hash(i+vec2(1.0,1.0));
        return mix(mix(a,b,f.x), mix(c,d,f.x), f.y);
    }
    float fbm(vec2 p) {
        float v = 0.0;
        float a = 0.5;
        for(int i=0;i<3;i++){
            v += a*noise(p);
            p *= 2.0;
            a *= 0.5;
        }
        return v;
    }
    float domainWarpedNoise(vec2 p, float scale) {
        vec2 q = vec2(fbm(p*0.5*scale), fbm(p*0.5*scale + vec2(5.2,1.3)));
        return fbm((p + 0.5*q)*scale);
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0() * materialParams.uvScale + materialParams.uvOffset;

        // Albedo sRGB, perceptual
        vec3 albedo = texture(materialParams_albedoMap, uv).rgb * materialParams.albedoScale;
        material.baseColor.rgb = albedo;
        material.baseColor.a = 1.0;

        // Normal map: tangent space OpenGL convention +Y up, linear not sRGB
        // Tier 0: recompute from height derivative at displaced resolution OR use shipped normal map (choose by tier)
        // For tier 0, use normal map; for tier 2/3, derive from height
        vec3 normalTS = texture(materialParams_normalMap, uv).xyz * 2.0 - 1.0;
        normalTS.xy *= materialParams.normalStrength;
        material.normal = normalTS;

        // AO multiplies ambient/indirect only, never direct sun
        float ao = texture(materialParams_aoMap, uv).r;
        material.ao = ao;

        // Roughness scalar
        material.roughness = materialParams.roughness;
        material.metallic = 0.0;

        // Horizon-map shadows per §6.6: 16 azimuths, quantized 0..255 over 0..90 deg
        // Runtime: if sun elevation below horizon angle for sun's azimuth bin, texel in shadow
        // Interpolate between two nearest azimuth bins, smooth step ~1 deg
        if (materialParams.horizonEnabled > 0.5) {
            vec3 sunDir = normalize(materialParams.sunDirection);
            // Compute sun azimuth and elevation in tangent space (simplified: use world space for demo)
            float sunAzimuth = atan(sunDir.x, sunDir.z); // -pi..pi
            float sunElevation = asin(clamp(sunDir.y, -1.0, 1.0)); // -pi/2..pi/2, degrees = elevation*180/pi
            float elevDeg = sunElevation * 57.29578;

            // Map azimuth to 0..15 bin
            float azNorm = (sunAzimuth + 3.14159) / (6.28318); // 0..1
            float azBinF = azNorm * 16.0;
            float azBin0 = floor(azBinF);
            float azBin1 = mod(azBin0+1.0, 16.0);
            float azFrac = fract(azBinF);

            // Horizon map stores 16 values as R8 in 4x RGBA8 or 16x R8; for simplicity sample as 2D where x=azimuth bin/16, y=0
            // Real implementation: texture(horizonMap, vec2((azBin0+0.5)/16.0, 0.5)).r etc.
            // Here we approximate with single channel lookup
            float horizon0 = texture(materialParams_horizonMap, vec2((azBin0+0.5)/16.0, 0.5)).r * 90.0; // quantized 0..255 -> 0..90 deg
            float horizon1 = texture(materialParams_horizonMap, vec2((azBin1+0.5)/16.0, 0.5)).r * 90.0;
            float horizonAngle = mix(horizon0, horizon1, azFrac);

            // If sun elevation below horizon angle, in shadow: multiply direct sun by 0 with smooth step ~1 deg
            float shadow = smoothstep(horizonAngle - 1.0, horizonAngle + 1.0, elevDeg);
            // shadow = 0 in shadow, 1 in light; multiply direct sun term
            // In Filament, we cannot directly multiply sun, but we can darken baseColor by shadow factor for direct
            // For demo, we apply to baseColor as approximation; real shader would modulate light visibility
            material.baseColor.rgb *= mix(0.15, 1.0, shadow); // ambient remains, direct reduced
        }

        // Procedural micro-detail optional off by default for science modes, on for inspection
        // Always reported through data HUD state, uses noise field that does not tile visibly
        if (materialParams.proceduralStrength > 0.001) {
            float n = domainWarpedNoise(uv * 10.0, materialParams.proceduralScale);
            vec3 detail = vec3(n*0.1);
            material.baseColor.rgb += detail * materialParams.proceduralStrength;
        }
    }
}
