/**
 * M11 blackHoleLens — precomputed-table beam tracing (skybox domain)
 * Per §12, see blackhole-lut tool
 * - LUTs: D(e,u) and U(e,phi) tables plus blackbody colour table, with --verify verb comparing table results against direct numerical integration
 * - Lensing material in skybox domain, sampling deep map with deflected directions
 * - Disk geometry and material: temperature profile, blackbody colour lookup, Doppler and gravitational shift
 */

material {
    name : blackHoleLens,
    shadingModel : unlit,
    blending : opaque,
    parameters : [
        { type : sampler2d, name : deflectionLut }, // D(e,u)
        { type : sampler2d, name : transferLut }, // U(e,phi)
        { type : sampler2d, name : blackbodyLut },
        { type : sampler2d, name : deepMap },
        { type : float, name : blackHoleMass },
        { type : float, name : spin },
        { type : float, name : inclination }
    ],
    requires : [ uv0, worldPosition ],
    culling : back
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0();
        // Deflected direction from LUT: sample deflection angle based on impact parameter
        vec3 viewDir = normalize(getWorldViewVector());
        float e = length(viewDir.xz); // impact parameter proxy
        float u = 1.0 / length(getWorldPosition()); // 1/r

        float deflection = texture(materialParams_deflectionLut, vec2(e, u)).r;

        // Transfer function U(e,phi) gives source direction
        float phi = atan(viewDir.z, viewDir.x);
        vec2 deflectedDirUv = texture(materialParams_transferLut, vec2(e, phi/6.28318)).rg;
        vec3 deflectedDir = vec3(deflectedDirUv, sqrt(max(0.0, 1.0 - dot(deflectedDirUv, deflectedDirUv))));

        // Sample deep map with deflected direction
        vec3 sky = texture(materialParams_deepMap, deflectedDir.xy*0.5+0.5).rgb;

        // Disk with temperature profile, blackbody colour lookup, Doppler and gravitational shift
        // Simplified: if ray hits disk plane, sample temperature and blackbody
        float diskHit = step(0.9, abs(dot(viewDir, vec3(0.0,1.0,0.0)))); // placeholder
        vec3 diskColor = texture(materialParams_blackbodyLut, vec2(0.5, 0.5)).rgb * diskHit;

        material.baseColor.rgb = sky + diskColor;
        material.emissive.rgb = sky * 0.5;
    }
}
