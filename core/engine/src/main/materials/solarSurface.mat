/**
 * M6 solarSurface — procedural photosphere, limb darkening, spots
 * Per §8.4
 * - Photosphere: 3-octave domain-warped noise for granulation, animated in third time-like dimension (never by scrolling UVs); supergranular network mask; sunspots injected from small table of real active regions with umbra and penumbra temperatures ~4000K and 5000-5500K
 * - Limb darkening: use published limb-darkening coefficients (1D polynomial in mu) rather than artistic curve
 * - Emission: output radiance well above scene's mid grey so tone mapping and bloom engage; expose emission scale parameter so exposure control still works
 * - The Sun must never be a flat yellow sphere with a texture
 */

material {
    name : solarSurface,
    shadingModel : unlit,
    blending : opaque,
    parameters : [
        { type : float, name : emissionScale },
        { type : float, name : time }, // driven by rotation control, never wall clock per P4, third dimension
        { type : float, name : limbDarkeningA },
        { type : float, name : limbDarkeningB },
        { type : float, name : limbDarkeningC },
        { type : sampler2d, name : activeRegionMap }, // small table of real active regions
        { type : float3, name : umbraColor },
        { type : float3, name : penumbraColor }
    ],
    requires : [ uv0 ],
    culling : back
}

fragment {
    float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7)))*43758.5453); }
    float noise(vec3 p){
        vec3 i=floor(p); vec3 f=fract(p); f=f*f*(3.0-2.0*f);
        // 3D noise via 2D hash trick
        float n = dot(i, vec3(1.0,57.0,113.0));
        return fract(sin(n)*43758.5453);
    }
    float fbm(vec3 p){
        float v=0.0; float a=0.5;
        for(int i=0;i<3;i++){ v+=a*noise(p); p*=2.0; a*=0.5; }
        return v;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0();
        // 3-octave domain-warped noise for granulation, animated in third time-like dimension (never by scrolling UVs)
        vec3 p = vec3(uv*10.0, materialParams.time*0.1);
        float granulation = fbm(p);

        // Supergranular network mask (larger scale)
        float supergranular = fbm(p*0.2) * 0.5 + 0.5;

        // Sunspots injected from small table of real active regions with umbra and penumbra temperatures
        vec3 spot = texture(materialParams_activeRegionMap, uv).rgb; // r=umbra mask, g=penumbra mask
        vec3 color = mix(vec3(1.0, 0.9, 0.6), materialParams.umbraColor, spot.r);
        color = mix(color, materialParams.penumbraColor, spot.g * (1.0-spot.r));

        // Base photosphere color modulated by granulation
        vec3 photosphere = vec3(1.0, 0.95, 0.8) * (0.8 + 0.4*granulation) * (0.9 + 0.2*supergranular);
        photosphere = mix(photosphere, color, max(spot.r, spot.g));

        // Limb darkening: use published limb-darkening coefficients (1D polynomial in mu) rather than artistic curve
        // Coefficients from Allen or Pierce & Slaughter: I(mu)/I(1) = 1 - a(1-mu) - b(1-mu)^2 - c(1-mu)^3 etc.
        // Here we use a,b,c as parameters with default justified in comments: a=0.3, b=0.3, c=0.1 approx for 500nm
        vec3 viewDir = getWorldViewVector();
        vec3 normal = getWorldGeometricNormalVector();
        float mu = clamp(dot(normal, normalize(viewDir)), 0.0, 1.0);
        float oneMinusMu = 1.0 - mu;
        float limb = 1.0 - materialParams.limbDarkeningA*oneMinusMu - materialParams.limbDarkeningB*oneMinusMu*oneMinusMu - materialParams.limbDarkeningC*pow(oneMinusMu,3.0);
        limb = max(limb, 0.1);

        // Emission: output radiance well above scene's mid grey so tone mapping and bloom engage
        // Expose emission scale parameter so exposure control still works
        vec3 emission = photosphere * limb * materialParams.emissionScale * 10.0; // well above mid grey (0.18)

        material.baseColor.rgb = vec3(0.0);
        material.emissive.rgb = emission;
        material.emissive.a = 1.0;
    }
}
