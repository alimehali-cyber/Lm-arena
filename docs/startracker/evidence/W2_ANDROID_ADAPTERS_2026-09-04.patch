+    /** W2: Y plane -> GrayscaleImage (luminance only; the pipeline's background
+     *  estimator handles illumination). Rows are copied row-stride aware. Returns
+     *  null for non-YUV formats. UNEXECUTED — validated only by harness unit tests
+     *  of the pure pipeline, never on a device. */
+    private fun toGrayscale(imageProxy: ImageProxy): GrayscaleImage? {
+        if (imageProxy.format != android.graphics.ImageFormat.YUV_420_888) return null
+        val plane = imageProxy.planes[0]   // Y
+        val w = imageProxy.width
+        val h = imageProxy.height
+        val data = FloatArray(w * h)
+        val buf = plane.buffer
+        val rowStride = plane.rowStride
+        for (row in 0 until h) {
+            for (col in 0 until w) {
+                data[row * w + col] = buf.get(row * rowStride + col).toFloat() and 0xFF
+            }
+        }
+        return GrayscaleImage(w, h, data)
+    }

